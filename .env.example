# App
PORT=3000
NODE_ENV=development
ENABLE_CRON_LOGS=false

# Database (choose one)
# Option A: Vercel Postgres / Neon / Supabase direct connection
DATABASE_URL=postgres://user:password@host:5432/database

# Option B: legacy env vars
DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=

# Firebase (optional for cron logs)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# AI provider keys are server-only. Never use VITE_ prefixes for secrets.
# Local AI SDK calls can use an AI Gateway API key. Vercel deployments can use OIDC.
AI_GATEWAY_API_KEY=
AI_GATEWAY_MODEL=moonshotai/kimi-k3
OPENROUTER_API_KEY=
GROQ_API_KEY=
MINIMAX_API_KEY=
GEMINI_API_KEY=

# Supabase Auth (publishable anon key is safe to expose in the browser; never use a service-role key there)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_ANON_KEY=
