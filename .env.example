# App
PORT=3000
NODE_ENV=development

# Database (choose one)
# Option A: Vercel Postgres / Neon / Supabase direct connection
DATABASE_URL=postgres://user:password@host:5432/database

# Option B: legacy env vars
DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=

# Firebase (optional for cron logs)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# AI providers (free tier recommended)
VITE_OPENROUTER_API_KEY=
OPENROUTER_API_KEY=
VITE_GROQ_API_KEY=
GROQ_API_KEY=
VITE_MINIMAX_API_KEY=
MINIMAX_API_KEY=
VITE_GEMINI_API_KEY=
GEMINI_API_KEY=

# Supabase (optional if you prefer it for auth + storage + tables)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
